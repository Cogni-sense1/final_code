# ─────────────────────────────────────────────────────────────────────────────
# CogniSense / NeuroVoice — example environment variables
#
# Copy this file to `.env` and fill in values for your environment.
# DO NOT commit real secrets. `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Web app (Vite) ───────────────────────────────────────────────────────────
# Base URL of the NeuroVoice backend that serves POST /predict.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Falls back to http://localhost:5050 if unset.
VITE_API_BASE_URL=http://localhost:5050

# ── Node backend (backend/node) ──────────────────────────────────────────────
# Port the Express server listens on (defaults to 5050 if unset).
PORT=5050
# Twilio credentials — ONLY needed for the optional WhatsApp webhook.
# The web/mobile screening flow does NOT require these. Leave blank for local dev.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Mobile app (neurovoice-mobile, Expo) ─────────────────────────────────────
# Base URL of the backend for the Expo app. Variables prefixed with
# EXPO_PUBLIC_ are exposed to the app at runtime. Falls back to
# http://localhost:5050 if unset. Set this in neurovoice-mobile/.env.
EXPO_PUBLIC_BACKEND_URL=http://localhost:5050
