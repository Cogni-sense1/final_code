# Local development needs none of these. Copy to .env only for the options you want.

# The companion (Bedrock), hearing (Transcribe), and speaking (Polly) are used whenever AWS
# credentials work on this machine. Set to false to force the offline fallbacks.
NV_AWS_AI=true
AWS_REGION=ap-south-1
BEDROCK_REGION=us-east-1
# Any Bedrock chat model with tool use. Nova needs no sign-up. Claude needs the Anthropic
# use-case form submitted in the Bedrock console first, e.g. us.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# WhatsApp through the Twilio sandbox. PUBLIC_URL is the https address Twilio calls
# (for example a tunnel to http://localhost:8787).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
PUBLIC_URL=

# Web app (apps/web/.env): where the API lives.
# VITE_API_URL=http://localhost:8787

# Mobile app (apps/mobile/.env): your computer's address as seen from the phone.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8787
