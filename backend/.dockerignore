# Build context is backend/. Keep the image lean and avoid leaking local state.

# Node
**/node_modules
node/npm-debug.log*

# Python caches / local virtualenvs (including stray committed ones)
**/__pycache__
**/*.py[cod]
python/venv
python/.venv
python/not
python/already
python/created
python/if
python/#

# Local persistence / runtime artifacts (regenerated in-container)
node/data
**/*.db
**/*.db-shm
**/*.db-wal
temp_audio
**/temp_audio

# Secrets & logs (never bake into the image)
**/.env
**/.env.*
**/*.log

# Docs / VCS noise
**/.DS_Store
